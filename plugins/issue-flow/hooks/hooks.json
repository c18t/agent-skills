{
  "description": "GitHub MCP の書き込み系ツールを実行前に検査する。@@FILE: センチネルにファイル実体を注入する",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*github.*__(push_files|create_or_update_file|issue_write|create_pull_request|merge_pull_request|add_issue_comment)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/python.sh\" \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/github_write_guard.py\"",
            "commandWindows": "& \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\\scripts\\python.cmd\" \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\\scripts\\github_write_guard.py\"",
            "timeout": 10,
            "statusMessage": "github-guard: 書き込みを検査中"
          }
        ]
      }
    ]
  }
}
