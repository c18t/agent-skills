{
  "description": "notion-update-page を実行前に検査する。@@FILE: センチネルの注入と update_content の抑制",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*notion[-_]update[-_]page",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/python.sh\" \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/notion_write_guard.py\"",
            "commandWindows": "& \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\\scripts\\python.cmd\" \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\\scripts\\notion_write_guard.py\"",
            "timeout": 10,
            "statusMessage": "notion-guard: 書き込みを検査中"
          }
        ]
      }
    ]
  }
}
